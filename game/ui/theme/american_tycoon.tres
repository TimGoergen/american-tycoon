[gd_resource type="Theme" format=3]

; American Tycoon central UI Theme — FONT-SIZE CASCADE ONLY (2026-07-23).
;
; This resource holds ONLY the app-wide default font sizes, so any control that
; does not set its own size still reads large (the Art Style Guide §1b readability
; bar). It is assigned on the Main root and registered as the project default theme
; (project.godot [gui] theme/custom), so the sizes cascade to every descendant.
;
; The three sizes MIRROR the type-scale constants in scripts/ui/UiPalette.gd — keep
; them in sync:
;   default_font_size = FONT_BODY   (32)  — backstop for anything un-themed
;   Button font_size  = FONT_BUTTON (34)
;   Label font_size   = FONT_BODY   (32)
;
; DELIBERATELY NOT IN THIS THEME: button plates, panel chrome, and text colors.
; Every control styles ITSELF explicitly via the style_button() / make_*_style()
; helpers in UiPalette.gd. A code audit (2026-07-23) confirmed there are no
; un-styled ("bare") controls, so cascading default styleboxes here would change
; nothing visually while hiding each control's look behind a global default. Keeping
; styling at the call site is the readable choice; the theme's only job is the size
; floor. If you ever add a control that should look standard, style it explicitly.

[resource]
default_font_size = 32
Button/font_sizes/font_size = 34
Label/font_sizes/font_size = 32
